meta {
  name: motta inntektsmelding
  type: http
  seq: 5
}

patch {
  url: https://platform.tt02.altinn.no/dialogporten/api/v1/serviceowner/dialogs/{{dialogId}}
  body: json
  auth: none
}

body:json {
  [
    {
      "op": "add",
      "path": "/status",
      "value": "NotApplicable"
    },
    {
      "op": "replace",
      "path": "/guiActions",
      "value": [
        {
          "name": "Se og endre inntektsmelding",
          "title": [
            {
              "value": "Se og endre inntektsmelding",
              "languageCode": "nb"
            }
          ],
          "action": "read",
          "url": "{{guiBaseUrl}}/im-dialog/{{eksempelForespoerselId}}",
          "priority": "Secondary"
        }
      ]
    },
      {
      "op": "replace",
      "path": "/apiActions",
      "value": []
    },
    {
      "op": "add",
      "path": "/transmissions",
      "value": [
        {
          "relatedTransmissionId": "{{forespoerselTransmissionId}}",
          "type": "Submission",
          "extendedType": "INNTEKTSMELDING",
          "externalReference": "{{eksempelInntektsmeldingId}}",
          "sender": {
            "actorType": "ServiceOwner"
          },
          "content": {
            "title": {
              "value": [
                {
                  "value": "Inntektsmelding mottatt",
                  "languageCode": "nb"
                }
              ],
              "mediaType": "text/plain"
            }
          },
          "attachments": [
            {
              "displayName": [
                {
                  "value": "inntektsmelding.json",
                  "languageCode": "nb"
                }
              ],
              "urls": [
                {
                  "url": "{{apiBaseUrl}}/v1/inntektsmelding/{{eksempelInntektsmeldingId}}",
                  "mediaType": "application/json",
                  "consumerType": "Api"
                }
              ]
            },
            {
              "displayName": [
                {
                  "value": "Se og endre inntektsmelding",
                  "languageCode": "nb"
                }
              ],
              "urls": [
                {
                  "url": "{{guiBaseUrl}}/im-dialog/{{eksempelForespoerselId}}",
                  "mediaType": "text/html",
                  "consumerType": "Gui"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}

tests {
  test("status code should be 204", function() {
    const statusCode = res.getStatus();
    expect(statusCode).to.equal(204);
  });
}
