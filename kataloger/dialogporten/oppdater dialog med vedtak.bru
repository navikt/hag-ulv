                {
                  "value": "Refusjonsvedtak",
                  "languageCode": "nb"
                }
              ],
              "mediaType": "text/plain"
            }
          },
          "attachments": [
            {
              "displayName": [
                {
                  "value": "refusjonsvedtak.json",
                  "languageCode": "nb"
                }
              ],
              "urls": [
                {
                  "url": "{{apiBaseUrl}}/v1/refusjonsvedtak/{{eksempelRefusjonsvedtakId}}",
